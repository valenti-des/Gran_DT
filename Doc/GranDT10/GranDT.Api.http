@host = http://localhost:5080
@email = grantd.{{$guid}}@example.test

### Crear usuario
# @name crearUsuario
POST {{host}}/api/usuarios
Content-Type: application/json

{
  "nombre": "Ana",
  "apellido": "Ejemplo",
  "email": "{{email}}",
  "fechaNac": "2000-03-15",
  "contrasena": "ClaveLocalTemporal123",
  "es_admin": false
}

### Crear plantilla
# @name crearPlantilla
POST {{host}}/api/usuarios/{{crearUsuario.response.body.$.idUsuario}}/plantillas
Content-Type: application/json

{
  "nombreP": "Plantilla reproducible",
  "presupuesto": 100000000,
  "cantFutbolista": 20
}

### Crear arquero
# @name crearArquero
POST {{host}}/api/futbolistas
Content-Type: application/json

{
  "nombre": "Arquero",
  "apellido": "Prueba",
  "apodo": "Uno",
  "fechaNac": "1998-04-12",
  "cotizacion": 5000000,
  "idEquipo": 1,
  "idTipoFutbolista": 1
}

### Incorporar arquero
POST {{host}}/api/plantillas/{{crearPlantilla.response.body.$.idPlantilla}}/jugadores
Content-Type: application/json

{
  "idFutbolista": {{crearArquero.response.body.$.idFutbolista}},
  "futbolistaTitular": true
}

### Actualizar cotización del arquero
PUT {{host}}/api/futbolistas/{{crearArquero.response.body.$.idFutbolista}}
Content-Type: application/json

{
  "nombre": "Arquero",
  "apellido": "Prueba",
  "apodo": "Uno",
  "fechaNac": "1998-04-12",
  "cotizacion": 4500000,
  "idEquipo": 1,
  "idTipoFutbolista": 1
}

### Pasar arquero a suplente
PUT {{host}}/api/plantillas/{{crearPlantilla.response.body.$.idPlantilla}}/jugadores/{{crearArquero.response.body.$.idFutbolista}}
Content-Type: application/json

{
  "futbolistaTitular": false
}

### Volver a titular
PUT {{host}}/api/plantillas/{{crearPlantilla.response.body.$.idPlantilla}}/jugadores/{{crearArquero.response.body.$.idFutbolista}}
Content-Type: application/json

{
  "futbolistaTitular": true
}

### Registrar puntuación
POST {{host}}/api/futbolistas/{{crearArquero.response.body.$.idFutbolista}}/puntuaciones
Content-Type: application/json

{
  "puntuacion": 8.5,
  "nroFecha": 1
}

### Crear e incorporar defensor 1
# @name crearDefensor1
POST {{host}}/api/futbolistas
Content-Type: application/json

{"nombre":"Defensor","apellido":"Uno","fechaNac":"1998-01-01","cotizacion":5000000,"idEquipo":1,"idTipoFutbolista":2}

### Incorporar defensor 1
POST {{host}}/api/plantillas/{{crearPlantilla.response.body.$.idPlantilla}}/jugadores
Content-Type: application/json

{"idFutbolista":{{crearDefensor1.response.body.$.idFutbolista}},"futbolistaTitular":true}

